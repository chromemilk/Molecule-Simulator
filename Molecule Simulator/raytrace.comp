#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) uniform writeonly image2D img;

struct Sphere { vec3 c; float r; };
layout(std430, binding = 1) readonly buffer Spheres { Sphere spheres[]; };

uniform vec3 camPos;
uniform mat4 invProjView;

vec3 primaryDir(ivec2 pix, ivec2 res)
{
    vec2 uv = (vec2(pix) + 0.5) / vec2(res) * 2.0 - 1.0;
    vec4 clip = vec4(uv, -1.0, 1.0);
    vec4 world = invProjView * clip;
    return normalize(world.xyz/world.w - camPos);
}

bool hitSphere(vec3 O, vec3 D, Sphere s, out float t)
{
    vec3 oc = O - s.c;
    float b = dot(oc,D);
    float c = dot(oc,oc) - s.r*s.r;
    float h = b*b - c;
    if(h < 0.0) return false;
    h = sqrt(h);
    t = -b - h;
    if(t < 0.0) t = -b + h;
    return t > 0.0;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(img);
    if(any(greaterThanEqual(pix,res))) return;

    vec3 O = camPos;
    vec3 D = primaryDir(pix,res);

    vec3 col = vec3(0.6,0.8,1.0);   // sky
    float  tMin = 1e30;
    for(uint i=0;i<spheres.length();++i)
    {
        float t;
        if(hitSphere(O,D,spheres[i],t) && t < tMin)
        {
            tMin = t;
            vec3 hit = O + D*t;
            vec3 N   = normalize(hit - spheres[i].c);
            col      = 0.5 + 0.5*N;  // simple normal-based colouring
        }
    }
    imageStore(img, pix, vec4(col,1));
}
